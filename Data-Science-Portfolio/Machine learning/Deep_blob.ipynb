#Importing libraries

import torch
import pandas as pd
from torch import nn
import matplotlib.pyplot as plt
from sklearn.datasets import make_circles
from sklearn.model_selection import train_test_split
from helper_function import plot_decision_boundary

X, Y = make_circles(n_samples=1000, noise=0.05, random_state=42)

circle = pd.DataFrame({"X1": X[:, 0], "X2": X[:, 1], "Target": Y})

#Displaying our data 
plt.scatter(x=X[:, 0], y=X[:, 1], c=Y, cmap=plt.cm.RdYlBu)

#Converting Numpy to tensors
x_tensor = torch.as_tensor(X)
y_tensor = torch.as_tensor(Y, dtype = torch.float64)

device = ("cuda" if torch.cuda.is_available() else "cpu")

#Splitting data into training and testing
X_train, X_test, Y_train, Y_test = train_test_split(x_tensor, y_tensor, test_size=0.3, random_state=42)

#Creating the class of layers
class ModelClassification(nn.Module):
    def __init__(self):
        super().__init__()
        self.network = nn.Sequential(
            nn.Linear(in_features=2, out_features=60),
            nn.ReLU(),
            nn.Linear(in_features=60, out_features=60),
            nn.ReLU(),
            nn.Linear(in_features=60, out_features=60),
            nn.ReLU(),
            nn.Linear(in_features=60, out_features=1)
            )

    def forward(self, x):
        return self.network(x)
    
#Instatiating our class of layers to Model
Model = ModelClassification().to(device)

try:
    #
    with torch.inference_mode():
        untrained = Model(X_test.to(device).float())

    #Calling our Loss function and Optimizer
    loss_fn = nn.BCEWithLogitsLoss()
    optimizer = torch.optim.SGD(params=Model.parameters(), lr=0.01)

    #Creating an accuracy function
    def accuracy_function(y_true, y_pred):
        correct = torch.eq(y_true, y_pred).sum().item() #eq =equals 
        #it checkes if y_true is equal to y_pred then sum b4 getting all the items
        acc = (correct/len(y_pred)) * 100
        return acc

    #Evaluating model and creating activation using "sigmoid"
    Model.eval()
    with torch.inference_mode():
        y_logit = Model(X_test.to(device).float())
        y_sigmoid = torch.sigmoid(y_logit)

    epochs = 20000
        
    for epoch in range(epochs):
        Model.train()
            
        #Training
        X_logits = Model(X_train.float()).squeeze()
        y_preds = torch.round(torch.sigmoid(X_logits))
    
        loss = loss_fn(X_logits, Y_train)
    
        #Calculate accuracy
        acc = accuracy_function(y_true=Y_train, y_pred=y_preds)

        #Bringing loss near to zero
        optimizer.zero_grad()

        #BackPropergation
        loss.backward()

        #Updates teh mode weight
        optimizer.step()
            
        #Testing
        Model.eval()
        with torch.inference_mode():
            test_logit = Model(X_test.to(device).float()).squeeze()
            test_pred = torch.round(torch.sigmoid(test_logit))
    
            test_loss = loss_fn(test_logit, Y_test)
            test_acc = accuracy_function(y_true=Y_test, y_pred=test_pred)
    
        if epoch % 100 == 0:
            print(f"epoch: {epoch} | loss: {loss:.4f} | accuracy: {acc:.4f} | test loss: {test_loss:.4f} | test accuracy: {test_acc:.4f}".title())

    #Visualizing our data predictions
    plt.figure(figsize=(7, 7))
    
    #Training data
    plt.subplot(1, 2, 1)
    plt.title("Plotting Training Data.")
    plot_decision_boundary(Model, X_train, Y_train)
    
    #Testing data
    plt.subplot(1, 2, 2)
    plt.title("Plotting Testing Data.")
    plot_decision_boundary(Model, X_test, Y_test)

except Exception as error:
    print(f"Error: {error}")
